{
  "name": "tabbit",
  "private": true,
  "workspaces": [
    "sdk",
    "app"
  ],
  "scripts": {
    "build:program": "anchor build && node scripts/copy-idl.mjs",
    "test:program": "anchor test",
    "build:sdk": "npm run build -w @tabbit/sdk",
    "dev": "npm run dev -w app",
    "build": "npm run build:sdk && npm run build -w app",
    "seed": "ts-node --transpile-only -P tsconfig.json scripts/seed-devnet.ts",
    "key:export": "ts-node --transpile-only -P tsconfig.json scripts/export-key.ts",
    "migrate:approval": "ts-node --transpile-only -P tsconfig.json scripts/migrate-approval.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "^0.4.15",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.6.3"
  }
}
