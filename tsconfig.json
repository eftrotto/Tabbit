{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "lib": ["es2020", "dom"],
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts", "sdk/src/**/*.ts"]
}
